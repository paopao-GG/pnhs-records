# Copy to .env.local for development, and set the same names in the Vercel project.
# Never commit a filled-in copy - .gitignore covers .env.* apart from this file.

# ---------------------------------------------------------------- database
# Unset: the app uses data/pnhs.db on this machine, which is what the verification
# scripts run against. Set both to point at a hosted libSQL database instead.
#
# Create the database in the region nearest the school (Singapore) - every query is a
# round trip, and a record page makes several.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Overrides the local database path. Used by the tests to reach a scratch file; you
# only need it to open a backup:  PNHS_DB_PATH=backups/pnhs-2026-01-01.db
# PNHS_DB_PATH=

# ----------------------------------------------------------- original files
# Unset: imported originals are written to data/originals/ on this machine.
# Set all four to store them in Cloudflare R2.
#
# The bucket MUST stay private. Files are served back through the app, which checks
# the session; a public bucket URL would be a shareable link to a child's record.
#
# For browser uploads, the bucket also needs a CORS rule allowing PUT from the app's
# origin - both http://localhost:3000 and the deployed URL. Without it uploads fail
# with an unhelpful network error.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ------------------------------------------------------------------ admin
# Read by `npm run create-admin` only, so the password does not land in shell history.
# Not needed at runtime.
# PNHS_ADMIN_PASSWORD=
