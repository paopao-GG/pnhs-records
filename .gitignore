node_modules/
.next/
next-env.d.ts
*.tsbuildinfo

# The records database. Never commit learner data.
data/

# Generated SF10 files from the spike and export checks.
spike-output/

# The packaged installer. It is built from the tree, and it is large.
dist/

# Secrets. Broad on purpose: .env.local was covered and .env.production.local was not,
# which is exactly the file that holds production credentials.
#
# The negation must stay LAST. Git takes the final matching pattern, so a later `.env.example`
# line silently re-ignores the one file here that is meant to be committed.
.env
.env.*
!.env.example

# Held the hosted database's URL and auth token. The deployment is gone; the line stays so a
# stale copy on somebody's machine cannot be committed by accident.
turso.txt
# Database backups. Learner data, same rule as data/.
backups/
